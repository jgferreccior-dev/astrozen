---
import "../styles/global.css";
import Header from "@components/Header.astro";
import { Font } from "astro:assets";
import { SITE_CONFIG } from "@config";
import Footer from "@components/Footer.astro";
import TrustStrip from "@components/TrustStrip.astro";

interface Props {
  title?: string;
  description?: string;
  profilePage?: boolean;
}

const {
  title: siteTitle,
  description: siteDescription,
  siteLogo,
  navLinks,
  lang,
  author,
  socialLinks,
  socialImage,
  canonicalURL,
} = SITE_CONFIG;

const { title = siteTitle, description = siteDescription, profilePage = false } = Astro.props;
const isHome = Astro.url.pathname === "/";
const canonicalBase = canonicalURL ?? "https://jgferreccior-dev.github.io/";
const resolvedCanonical = new URL(Astro.url.pathname, canonicalBase).href;
const ogImgUrl = new URL(socialImage, "https://jgferreccior-dev.github.io").href;
const resolvedNavLinks = navLinks.map((link) => ({
  ...link,
  href: isHome || !link.href.startsWith("#") ? link.href : `/${link.href}`,
}));

const personSchema = {
  "@type": "Person",
  "name": author,
  "jobTitle": "Digital Media & SEO Specialist",
  "description": siteDescription,
  "url": canonicalBase,
  "email": "mailto:jgferreccior@gmail.com",
  "sameAs": socialLinks.map((link) => link.href),
};

const structuredData = profilePage || isHome
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "name": author,
          "url": canonicalBase,
          "inLanguage": "es-PE",
          "description": siteDescription,
        },
        {
          "@type": "ProfilePage",
          "url": resolvedCanonical,
          "name": title,
          "mainEntity": personSchema,
        },
      ],
    }
  : null;
const structuredDataJson = structuredData ? JSON.stringify(structuredData) : null;
---

<!doctype html>
<html lang={lang} class="scroll-pt-16 scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#05080d" />
    <link rel="canonical" href={resolvedCanonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href={siteLogo} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <Font cssVariable="--font-gabarito" preload />
    <Font cssVariable="--font-be-vietnam-pro" preload />

    {structuredDataJson && <script type="application/ld+json" is:inline set:html={structuredDataJson}></script>}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={author} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:image" content={ogImgUrl} />
    <meta property="og:image:alt" content={`${author} — ${title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={resolvedCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImgUrl} />
  </head>
  <body class="bg-black font-sans">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-primary focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-white"
    >
      Saltar al contenido
    </a>
    <Header siteLogo={siteLogo} navLinks={resolvedNavLinks} />
    <main id="main-content" class="mx-auto max-w-5xl px-5">
      <slot />
      {isHome && <TrustStrip />}
    </main>
    <Footer author={author} socialLinks={socialLinks} />
  </body>
</html>
