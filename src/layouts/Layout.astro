---
import Header from "@components/Header.astro";
import { Font } from "astro:assets";
import { SITE_CONFIG } from "@config";
import Footer from "@components/Footer.astro";
import TrustStrip from "@components/TrustStrip.astro";

interface Props {
  title?: string;
  description?: string;
  profilePage?: boolean;
}

const {
  title: siteTitle,
  description: siteDescription,
  siteLogo,
  navLinks,
  lang,
  author,
  socialLinks,
  socialImage,
  canonicalURL,
} = SITE_CONFIG;

const { title = siteTitle, description = siteDescription, profilePage = false } = Astro.props;
const isHome = Astro.url.pathname === "/";
const canonicalBase = canonicalURL ?? "https://astrozen-josefr-89-9123.vercel.app/";
const resolvedCanonical = new URL(Astro.url.pathname, canonicalBase).href;
const ogImgUrl = new URL(socialImage, canonicalBase).href;
const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "name": author,
    "jobTitle": "Digital Media & SEO Specialist",
    "description": description,
    "sameAs": socialLinks.map((link) => link.href),
  },
};
const profileSchemaJson = JSON.stringify(profileSchema);
---

<!doctype html>
<html lang={lang} class="scroll-pt-16 scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={resolvedCanonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href={siteLogo} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <Font cssVariable="--font-gabarito" preload />
    <Font cssVariable="--font-be-vietnam-pro" preload />

    {(profilePage || isHome) && <script type="application/ld+json" is:inline set:html={profileSchemaJson}></script>}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:image" content={ogImgUrl} />
    <meta property="og:image:alt" content={`${author} — ${title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={resolvedCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImgUrl} />
  </head>
  <body class="bg-black font-sans">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-primary focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-white"
    >
      Saltar al contenido
    </a>
    <Header siteLogo={siteLogo} navLinks={navLinks} />
    <main id="main-content" class="mx-auto max-w-5xl px-5">
      <slot />
      {isHome && <TrustStrip />}
    </main>
    <Footer author={author} socialLinks={socialLinks} />
  </body>
</html>
