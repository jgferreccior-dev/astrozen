---
import Section from "./Section.astro";

interface Props {
  email: string;
}

const { email } = Astro.props;
---

<Section text="Contacto" href="contact">
  <div class="overflow-hidden rounded-2xl border border-white/10 bg-[#0b1118] p-7 md:p-10">
    <div class="grid gap-10 md:grid-cols-[1fr_auto] md:items-end">
      <div class="max-w-3xl">
        <p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-primary">Disponible para nuevos proyectos</p>
        <p class="mb-5 font-serif text-4xl font-semibold leading-tight text-white md:text-6xl">
          ¿Trabajamos juntos?
        </p>
        <p class="max-w-2xl text-base leading-8 text-neutral md:text-lg">
          Estoy interesado en proyectos de estrategia digital, contenidos, SEO, Social Media,
          Performance Marketing y comunicación digital orientados a resultados.
        </p>
      </div>
      <div class="flex flex-col items-start gap-3">
        <a
          href="/cv"
          class="rounded-full bg-primary px-8 py-4 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-[#0b1118]"
        >
          Ver CV →
        </a>
        <a
          href={`mailto:${email}`}
          class="rounded-full border border-white/20 px-8 py-4 text-sm font-medium text-white hover:border-white/45 focus:outline-none focus:ring-2 focus:ring-primary"
        >
          Escribirme por email
        </a>
        <a
          href="https://www.linkedin.com/in/jose-ferreccio-4211901b/"
          target="_blank"
          rel="noreferrer"
          class="text-sm font-medium text-white/65 hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary"
        >
          LinkedIn ↗
        </a>
      </div>
    </div>
  </div>
</Section>
