---
import Section from "./Section.astro";

const skills = [
  ["◎", "Estrategia", "Digital"],
  ["⌁", "SEO", ""],
  ["▤", "Content", "Strategy"],
  ["◒", "Performance", "Marketing"],
  ["∞", "Meta Ads", ""],
  ["◫", "Analytics", ""],
  ["⌕", "Search", "Console"],
  ["◉", "Social", "Media"],
  ["W", "WordPress", ""],
  ["◌", "Hootsuite", ""],
  ["C", "Canva", ""],
  ["A", "Adobe", ""],
  ["♪", "TikTok", "Business"],
  ["▦", "Excel /", "Sheets"],
];
---

<Section text="Skills & Tools" href="skills">
  <div class="rounded-2xl border border-white/10 bg-[#0b1118]/80 p-6 md:p-8">
    <div class="grid grid-cols-2 gap-y-8 sm:grid-cols-4 md:grid-cols-7">
      {skills.map(([icon, first, second]) => (
        <div class="group text-center">
          <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-xl border border-primary/30 bg-primary/5 font-serif text-xl font-semibold text-primary transition-transform group-hover:-translate-y-1">
            {icon}
          </div>
          <p class="mt-3 text-xs font-medium text-white/80">{first}</p>
          {second && <p class="text-xs text-white/45">{second}</p>}
        </div>
      ))}
    </div>
  </div>
</Section>
