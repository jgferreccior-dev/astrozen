---
import Section from "./Section.astro";

const skills = [
  ["01", "Estrategia Digital", "Planificación · Audiencias · Contenido"],
  ["02", "SEO", "Search · Search Console · WordPress"],
  ["03", "Content Strategy", "Editorial · Copywriting · Distribución"],
  ["04", "Social Media", "Facebook · Instagram · TikTok"],
  ["05", "Performance", "Meta Ads · Segmentación · Campañas"],
  ["06", "Analítica", "Google Analytics · KPI · Reporting"],
  ["07", "Herramientas", "Hootsuite · Canva · Adobe · Excel"],
];
---

<Section text="Skills & Tools" href="skills">
  <div class="grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
    {skills.map(([number, title, detail]) => (
      <article class="group bg-[#0b1118] p-6 transition duration-300 hover:bg-[#111923] md:p-7">
        <div class="mb-10 flex items-center justify-between">
          <span class="text-xs font-semibold tracking-[0.16em] text-primary">{number}</span>
          <span class="h-px w-10 bg-white/10 transition-all duration-300 group-hover:w-16 group-hover:bg-primary/50" aria-hidden="true"></span>
        </div>
        <h3 class="font-serif text-xl font-semibold tracking-tight text-white md:text-2xl">{title}</h3>
        <p class="mt-3 text-sm leading-6 text-neutral">{detail}</p>
      </article>
    ))}
  </div>

  <p class="mt-6 text-xs leading-6 text-white/40">
    Stack de trabajo: Meta Ads Manager · Meta Business Suite · TikTok Business · Google Analytics · Google Search Console · Hootsuite · WordPress · Adobe Photoshop · Premiere · Audition · Canva · Excel · Google Sheets.
  </p>
</Section>
