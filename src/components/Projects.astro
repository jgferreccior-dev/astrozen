---
import Section from "./Section.astro";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Proyectos destacados" href="projects">
  <div class="mb-12 flex items-end justify-between gap-6">
    <p class="max-w-2xl text-base leading-7 text-neutral md:text-lg">
      Casos donde estrategia, contenido, distribución y datos se combinan para construir audiencias y mejorar resultados digitales.
    </p>
    <span class="hidden text-sm font-medium text-primary md:block">Resultados primero →</span>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    {
      projects.map((project) => {
        const { name, role, period, summary, image, metrics, linkPreview, linkSource } = project;
        const projectHref = linkPreview || linkSource;

        return (
          <article class="group overflow-hidden rounded-2xl border border-white/10 bg-[#0b1118] transition duration-300 hover:-translate-y-1 hover:border-white/20">
            {projectHref ? (
              <a
                href={projectHref}
                target={linkPreview ? undefined : "_blank"}
                rel={linkPreview ? undefined : "noreferrer"}
                aria-label={`Ver caso de estudio: ${name}`}
                class="block focus:outline-none focus:ring-2 focus:ring-primary focus:ring-inset"
              >
                <div class="relative aspect-[16/9] overflow-hidden bg-[#111820]">
                  <img
                    src={image}
                    alt={`Vista previa del proyecto ${name}`}
                    loading="lazy"
                    class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
                    width="1200"
                    height="675"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#05080d]/75 via-transparent to-transparent" aria-hidden="true"></div>
                  <span class="absolute left-5 top-5 rounded-full border border-white/15 bg-black/45 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.16em] text-white/75 backdrop-blur-sm">
                    Caso de estudio
                  </span>
                </div>
              </a>
            ) : (
              <div class="relative aspect-[16/9] overflow-hidden bg-[#111820]">
                <img
                  src={image}
                  alt={`Vista previa del proyecto ${name}`}
                  loading="lazy"
                  class="h-full w-full object-cover"
                  width="1200"
                  height="675"
                />
              </div>
            )}

            <div class="p-7 md:p-8">
              <div class="mb-4 flex items-start justify-between gap-5">
                <div>
                  {projectHref ? (
                    <h3 class="font-serif text-2xl font-semibold tracking-tight text-white md:text-3xl">
                      <a
                        href={projectHref}
                        target={linkPreview ? undefined : "_blank"}
                        rel={linkPreview ? undefined : "noreferrer"}
                        class="rounded-sm transition-colors hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary"
                      >
                        {name}
                      </a>
                    </h3>
                  ) : (
                    <h3 class="font-serif text-2xl font-semibold tracking-tight text-white md:text-3xl">{name}</h3>
                  )}
                  {(role || period) && (
                    <p class="mt-2 text-xs font-medium uppercase tracking-[0.12em] text-white/45">
                      {role}{role && period ? " · " : ""}{period}
                    </p>
                  )}
                </div>
                {projectHref ? (
                  <a
                    href={projectHref}
                    target={linkPreview ? undefined : "_blank"}
                    rel={linkPreview ? undefined : "noreferrer"}
                    aria-label={`Abrir caso de estudio: ${name}`}
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-primary/50 text-xl text-primary transition-transform group-hover:-translate-y-1 group-hover:translate-x-1 focus:outline-none focus:ring-2 focus:ring-primary"
                  >
                    ↗
                  </a>
                ) : (
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 text-xl text-white/30">↗</span>
                )}
              </div>
              <p class="max-w-xl text-sm leading-7 text-neutral md:text-base">{summary}</p>

              {metrics?.length ? (
                <div class="mt-7 grid gap-3 border-y border-white/10 py-5 sm:grid-cols-2">
                  {metrics.map(([value, label]) => (
                    <div>
                      <p class="font-serif text-2xl font-bold tracking-tight text-white md:text-3xl">{value}</p>
                      <p class="mt-1 text-[11px] leading-5 text-white/45">{label}</p>
                    </div>
                  ))}
                </div>
              ) : null}

              {projectHref && (
                <a
                  href={projectHref}
                  target={linkPreview ? undefined : "_blank"}
                  rel={linkPreview ? undefined : "noreferrer"}
                  class="mt-6 inline-block rounded-sm text-sm font-semibold text-primary hover:text-white focus:outline-none focus:ring-2 focus:ring-primary"
                >
                  Ver caso de estudio →
                </a>
              )}
            </div>
          </article>
        );
      })
    }
  </div>
</Section>
