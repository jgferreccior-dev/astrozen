---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Proyectos destacados" href="projects">
  <p class="mb-12 max-w-2xl text-base leading-7 text-neutral md:text-lg">
    Casos donde estrategia, contenido, distribución y datos se combinan para construir audiencias y mejorar resultados digitales.
  </p>
  {
    projects.map(({ name, summary, image, linkSource }, index) => {
      const top = 98 + index * 40;
      return (
        <div
          style={`top: ${top}px;`}
          class="sticky mb-12 rounded-2xl border border-neutral/20 bg-black"
        >
          <div class="relative z-1 grid h-145 w-full grid-rows-2 overflow-hidden rounded-2xl bg-[#151b24] sm:grid-cols-2 sm:grid-rows-1 md:h-96">
            <div class="px-6 pt-12 sm:px-10">
              <p class="mb-4 text-xs font-medium uppercase tracking-[0.18em] text-neutral">
                Caso de estudio
              </p>
              <h3 class="mb-5 font-serif text-3xl font-medium text-primary">
                {name}
              </h3>
              <p class="max-w-lg text-base leading-7 text-neutral">{summary}</p>
              {linkSource && (
                <a
                  href={linkSource}
                  target="_blank"
                  rel="noreferrer"
                  class="mt-8 inline-block text-sm font-medium text-white hover:underline"
                >
                  Ver referencia ↗
                </a>
              )}
            </div>
            <div class="flex items-end justify-end overflow-hidden">
              <Image
                class="h-full w-full object-cover"
                src={image}
                alt={name}
                width="736"
                height="483"
              />
            </div>
          </div>
        </div>
      );
    })
  }
</Section>
