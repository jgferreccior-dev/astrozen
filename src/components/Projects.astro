---
import Section from "./Section.astro";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
const backgrounds = [
  "https://images.unsplash.com/photo-1558655146-d09347e92766?auto=format&fit=crop&w=1200&q=80",
  "https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=1200&q=80",
  "https://images.unsplash.com/photo-1499750310107-5fef28a66643?auto=format&fit=crop&w=1200&q=80",
  "https://images.unsplash.com/photo-1540747913346-19e32dc3e97e?auto=format&fit=crop&w=1200&q=80",
];
---

<Section text="Proyectos destacados" href="projects">
  <div class="mb-12 flex items-end justify-between gap-6">
    <p class="max-w-2xl text-base leading-7 text-neutral md:text-lg">
      Casos donde estrategia, contenido, distribución y datos se combinan para construir audiencias y mejorar resultados digitales.
    </p>
    <span class="hidden text-sm font-medium text-primary md:block">Resultados primero →</span>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    {
      projects.map(({ name, summary, linkPreview, linkSource }, index) => (
        <article class="group relative min-h-[340px] overflow-hidden rounded-2xl border border-white/10 bg-[#111820]">
          <div
            class="absolute inset-0 bg-cover bg-center transition duration-700 group-hover:scale-105"
            style={`background-image: url('${backgrounds[index % backgrounds.length]}');`}
            aria-hidden="true"
          ></div>
          <div class="absolute inset-0 bg-gradient-to-t from-[#05080d] via-[#07101a]/80 to-[#07101a]/25" aria-hidden="true"></div>
          <div class="relative flex min-h-[340px] flex-col justify-between p-7 md:p-8">
            <div class="flex items-start justify-between gap-5">
              <p class="text-xs font-medium uppercase tracking-[0.18em] text-white/60">Caso de estudio</p>
              <span class="flex h-10 w-10 items-center justify-center rounded-full border border-primary/70 bg-black/30 text-xl text-primary backdrop-blur-sm transition-transform group-hover:-translate-y-1 group-hover:translate-x-1">↗</span>
            </div>
            <div>
              <h3 class="mb-3 font-serif text-3xl font-semibold tracking-tight text-white">{name}</h3>
              <p class="max-w-xl text-sm leading-6 text-white/70">{summary}</p>
              {(linkPreview || linkSource) && (
                <a
                  href={linkPreview || linkSource}
                  target={linkPreview ? undefined : "_blank"}
                  rel={linkPreview ? undefined : "noreferrer"}
                  class="mt-6 inline-block text-sm font-semibold text-primary hover:text-white"
                >
                  Ver caso de estudio →
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</Section>
