---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, specialty, summary, email } = Astro.props;
---

<section class="relative isolate -mx-5 overflow-hidden border-b border-white/10 px-5 pb-20 pt-0 md:pb-28" id="hero">
  <div class="absolute left-0 right-0 top-0 h-28 border-b border-white/10 bg-[#3f454d]" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 top-28 -z-20 bg-cover bg-center" style="background-image: url('/hero-growth.svg');" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 top-28 -z-10 bg-gradient-to-r from-[#05080d] via-[#07101a]/90 to-[#07101a]/58" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 top-28 -z-10 bg-gradient-to-t from-[#05080d] via-[#05080d]/55 to-transparent" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-5xl">
    <div class="flex min-h-28 flex-col justify-center gap-3 py-5 md:flex-row md:items-center md:justify-between md:gap-8">
      <div class="min-w-0">
        <p class="text-sm font-semibold tracking-tight text-white sm:text-base md:text-lg">{name}</p>
        <p class="mt-1 text-[10px] font-medium uppercase tracking-[0.16em] text-white/55 sm:text-xs">{specialty}</p>
      </div>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[10px] font-medium uppercase tracking-[0.12em] text-white/65 sm:text-xs md:justify-end">
        <a class="rounded-sm transition-colors hover:text-white focus:outline-none focus:ring-2 focus:ring-primary" href={`mailto:${email}`}>{email}</a>
        <a class="rounded-sm transition-colors hover:text-white focus:outline-none focus:ring-2 focus:ring-primary" href="https://www.linkedin.com/in/jose-ferreccio-4211901b/" target="_blank" rel="noreferrer">LinkedIn</a>
      </div>
    </div>

    <div class="pt-12 md:pt-16">
      <div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-semibold uppercase tracking-[0.18em] text-white/65 sm:text-sm">
        <span>Estrategia · Contenido · SEO · Performance</span>
        <span class="hidden text-primary sm:inline">•</span>
        <span>10+ años de experiencia</span>
      </div>
      <h1 class="mb-5 max-w-4xl font-serif text-5xl font-bold leading-[0.95] tracking-tightest text-white sm:text-6xl md:text-8xl">
        Digital Media <span class="text-primary">&amp;</span><br />
        <span class="text-primary">SEO</span> Specialist
      </h1>
      <p class="mb-5 max-w-3xl text-xl font-medium leading-8 text-white sm:text-2xl md:text-3xl md:leading-10">
        Conecto contenido, audiencias y datos para convertir objetivos digitales en resultados medibles.
      </p>
      <p class="mb-9 max-w-2xl text-base leading-7 text-white/70 md:text-lg">{summary}</p>

      <div class="mb-12 flex flex-wrap gap-3">
        <a class="rounded-full bg-primary px-7 py-3.5 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-[#05080d]" href="#projects">Ver casos de estudio →</a>
        <a class="rounded-full border border-white/25 bg-black/20 px-7 py-3.5 text-sm font-medium text-white backdrop-blur-sm transition-colors hover:border-white/50 focus:outline-none focus:ring-2 focus:ring-white/60" href="/cv">Ver CV</a>
        <a class="rounded-full border border-white/25 bg-black/20 px-7 py-3.5 text-sm font-medium text-white backdrop-blur-sm transition-colors hover:border-white/50 focus:outline-none focus:ring-2 focus:ring-white/60" href={`mailto:${email}`}>Hablemos</a>
      </div>

      <div class="grid max-w-4xl grid-cols-2 border-y border-white/15 py-7 sm:grid-cols-4">
        <div class="border-r border-white/15 px-4 first:pl-0 sm:px-5"><p class="font-serif text-3xl font-bold text-white md:text-4xl">+275%</p><p class="mt-1 text-xs text-white/60 md:text-sm">alcance en RR.SS.</p></div>
        <div class="border-r border-white/15 px-4 sm:px-5"><p class="font-serif text-3xl font-bold text-white md:text-4xl">+802%</p><p class="mt-1 text-xs text-white/60 md:text-sm">clics hacia contenidos</p></div>
        <div class="border-r border-white/15 px-4 sm:px-5"><p class="font-serif text-3xl font-bold text-white md:text-4xl">+30%</p><p class="mt-1 text-xs text-white/60 md:text-sm">tráfico web</p></div>
        <div class="px-4 sm:px-5 sm:pr-0"><p class="font-serif text-3xl font-bold text-white md:text-4xl">145K+</p><p class="mt-1 text-xs text-white/60 md:text-sm">artículos gestionados</p></div>
      </div>
    </div>
  </div>
</section>
