---
import Section from "./Section.astro";
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

<Section text="Experiencia" href="experience">
  <p class="mb-12 max-w-2xl text-base leading-7 text-neutral md:text-lg">
    Trayectoria desarrollada entre medios de comunicación, plataformas digitales y comunicación académica.
  </p>
  {
    experience.map(({ company, position, startDate, endDate, summary }) => (
      <article class="mb-12 border-t border-white/10 pt-8">
        <div class="grid gap-4 md:grid-cols-[220px_1fr] md:gap-10">
          <div>
            <span class="text-sm text-white/60">{startDate} — {endDate}</span>
          </div>
          <div>
            <h3 class="mb-1 font-serif text-2xl font-semibold text-white">
              {position}
            </h3>
            <h4 class="mb-5 text-base font-medium text-primary">{company}</h4>
            {Array.isArray(summary) ? (
              <ul class="space-y-3">
                {summary.map((log) => (
                  <li class="relative pl-6 text-base leading-7 text-neutral before:absolute before:left-0 before:content-['→'] before:text-primary">
                    {log}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-base leading-7 text-neutral">{summary}</p>
            )}
          </div>
        </div>
      </article>
    ))
  }
</Section>
