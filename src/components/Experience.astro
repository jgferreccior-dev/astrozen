---
import Section from "./Section.astro";
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

<Section text="Experiencia" href="experience">
  <div class="mb-12 grid gap-6 md:grid-cols-[1fr_auto] md:items-end">
    <p class="max-w-2xl text-base leading-7 text-neutral md:text-lg">
      Trayectoria desarrollada entre medios de comunicación, plataformas digitales y comunicación académica.
    </p>
    <p class="hidden text-right text-xs font-medium uppercase tracking-[0.18em] text-white/40 md:block">
      Impacto · Contenido · Audiencias
    </p>
  </div>

  <div class="relative ml-2 border-l border-white/10 pl-8 md:ml-4 md:pl-12">
    {
      experience.map(({ company, position, startDate, endDate, summary }, index) => (
        <article class="relative mb-12 last:mb-0">
          <span
            class="absolute -left-[2.35rem] top-1.5 h-3 w-3 rounded-full border-2 border-black bg-primary shadow-[0_0_0_4px_rgba(255,255,255,0.05)] md:-left-[3.05rem]"
            aria-hidden="true"
          ></span>

          <div class="grid gap-5 md:grid-cols-[180px_1fr] md:gap-10">
            <div>
              <span class="text-sm font-medium text-white/55">{startDate} — {endDate}</span>
              {index === 1 || index === 2 ? (
                <p class="mt-2 text-[10px] font-semibold uppercase tracking-[0.16em] text-primary/80">
                  Rol en paralelo
                </p>
              ) : null}
            </div>

            <div class="border-b border-white/10 pb-12 last:border-0">
              <p class="mb-2 text-xs font-medium uppercase tracking-[0.16em] text-primary">{company}</p>
              <h3 class="mb-5 font-serif text-2xl font-semibold tracking-tight text-white md:text-3xl">
                {position}
              </h3>

              {Array.isArray(summary) ? (
                <ul class="space-y-4">
                  {summary.map((log) => (
                    <li class="relative pl-6 text-base leading-7 text-neutral before:absolute before:left-0 before:content-['→'] before:text-primary">
                      {log}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-base leading-7 text-neutral">{summary}</p>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</Section>
