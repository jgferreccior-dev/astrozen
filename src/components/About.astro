---
import Section from "./Section.astro";
import type { AboutProps, HeroProps } from "@types";

type Props = AboutProps & Pick<HeroProps, "name">;

const { description } = Astro.props;
---

<Section text="Sobre mí" href="about">
  <div class="grid gap-12 md:grid-cols-[1fr_280px] md:items-start">
    <div class="max-w-3xl">
      {description.split("\n\n").map((paragraph) => (
        <p class="mb-6 text-base leading-8 text-neutral md:text-lg">{paragraph.trim()}</p>
      ))}
    </div>
    <div class="border border-white/10 p-6">
      <p class="mb-4 text-xs font-medium uppercase tracking-[0.18em] text-neutral">Áreas de especialización</p>
      <ul class="space-y-3 text-sm text-white">
        <li>01 · Estrategia Digital</li>
        <li>02 · SEO &amp; Content</li>
        <li>03 · Social Media</li>
        <li>04 · Performance Marketing</li>
        <li>05 · Analítica Digital</li>
        <li>06 · Sports Media</li>
      </ul>
    </div>
  </div>
</Section>
