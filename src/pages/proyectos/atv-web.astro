---
import Layout from "@layouts/Layout.astro";
import Section from "@components/Section.astro";
---

<Layout>
  <Section text="Caso de estudio" href="projects">
    <div class="max-w-4xl">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-primary">Grupo ATV · Web & Content</p>
      <h1 class="font-serif text-4xl font-semibold tracking-tight text-white md:text-6xl">Gestión y producción de contenido digital a escala</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-neutral">Gestión editorial y producción de contenido digital para la plataforma web de ATV.</p>
      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-white/10 bg-[#0b1118] p-6"><strong class="font-serif text-4xl text-white">145K+</strong><p class="mt-2 text-sm text-neutral">artículos producidos con el equipo</p></div>
        <div class="rounded-2xl border border-white/10 bg-[#0b1118] p-6"><strong class="font-serif text-4xl text-white">1M+</strong><p class="mt-2 text-sm text-neutral">usuarios únicos mensuales</p></div>
      </div>
      <div class="mt-12 space-y-6 text-base leading-8 text-neutral">
        <h2 class="font-serif text-2xl font-semibold text-white">Responsabilidades</h2>
        <p>Coordinación de contenidos web, selección, revisión, organización y preparación de materiales antes de su publicación.</p>
        <p>El trabajo editorial se desarrolló a escala, contribuyendo a un promedio superior a 1 millón de usuarios únicos mensuales en la web de ATV.</p>
      </div>
      <a href="/#projects" class="mt-10 inline-block text-sm font-semibold text-primary hover:text-white">← Volver a proyectos</a>
    </div>
  </Section>
</Layout>
