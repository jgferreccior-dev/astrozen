---
import Layout from "@layouts/Layout.astro";

const caseStudies = {
  cicaj: {
    title: "CICAJ — Estrategia de crecimiento digital",
    eyebrow: "Caso de estudio · Comunicación académica",
    intro:
      "Estrategia digital para fortalecer el alcance, la interacción y la conversión de contenidos académicos dirigidos principalmente a audiencias de posgrado.",
    organization: "CICAJ · Pontificia Universidad Católica del Perú",
    image: "/project-cicaj.svg",
    reference: "https://www.pucp.edu.pe/cicaj/",
    metrics: [
      ["+275%", "alcance digital"],
      ["+448%", "visualizaciones de contenido"],
      ["+802%", "clics hacia inscripciones y contenidos"],
      ["3.1%", "engagement"],
    ],
    challenge:
      "La comunicación académica debía competir por atención en redes sociales y, al mismo tiempo, conducir a las audiencias hacia información de cursos, programas, convocatorias y actividades institucionales.",
    approach: [
      "Planificación de calendarios editoriales alineados con la oferta académica y el calendario institucional.",
      "Segmentación de audiencias y adaptación de mensajes para públicos de posgrado.",
      "Producción de contenidos para Facebook e Instagram, combinando piezas institucionales con formatos de mayor capacidad de interacción.",
      "Uso de Meta Ads para amplificar contenidos y apoyar objetivos de registro e interés.",
    ],
    results:
      "El trabajo permitió incrementar el alcance, las visualizaciones y los clics hacia contenidos académicos, manteniendo una estrategia de comunicación institucional orientada a resultados.",
    skills: "Content Strategy · Social Media · Meta Ads · Segmentación · Comunicación institucional · Analítica",
  },
  "atv-sports": {
    title: "ATV — Sports Media",
    eyebrow: "Caso de estudio · Medios digitales",
    intro:
      "Estrategia de contenidos y experiencias digitales para acompañar grandes eventos deportivos y convertir la cobertura en oportunidades de crecimiento para la plataforma web.",
    organization: "Grupo ATV",
    image: "/project-atv-sports.svg",
    reference: "https://www.atv.pe/",
    metrics: [
      ["+30%", "tráfico web"],
      ["−15%", "porcentaje de rebote"],
      ["3", "grandes eventos deportivos"],
    ],
    challenge:
      "Los grandes eventos deportivos generan picos de interés, pero requieren experiencias digitales capaces de concentrar tráfico, ofrecer contenido exclusivo y facilitar la navegación entre piezas de cobertura.",
    approach: [
      "Desarrollo y optimización de landing pages para eventos deportivos.",
      "Creación y organización de contenido exclusivo para reforzar la propuesta digital.",
      "Distribución multiplataforma y coordinación de contenidos vinculados a la cobertura.",
      "Trabajo sobre experiencias digitales asociadas a los Juegos Olímpicos de Tokio 2020, el Mundial de Qatar 2022 y la Champions League.",
    ],
    results:
      "Las experiencias desarrolladas contribuyeron a incrementar el tráfico web en 30% y reducir el porcentaje de rebote en 15% en los proyectos asociados a grandes eventos deportivos.",
    skills: "Digital Strategy · Sports Media · Content Strategy · Landing Pages · Web Content · Distribución digital",
  },
  "atv-web": {
    title: "ATV — Web & Content",
    eyebrow: "Caso de estudio · Gestión editorial",
    intro:
      "Gestión y producción de contenido digital a escala para una plataforma informativa con una alta frecuencia de publicación.",
    organization: "Grupo ATV",
    image: "/project-atv-web.svg",
    reference: "https://www.atv.pe/",
    metrics: [
      ["145K+", "artículos producidos con el equipo"],
      ["1M+", "usuarios únicos mensuales promedio"],
    ],
    challenge:
      "Trabajar con grandes volúmenes de información exige procesos editoriales consistentes, capacidad de priorización y adaptación del contenido al consumo digital.",
    approach: [
      "Coordinación de producción y publicación de contenidos con el equipo editorial.",
      "Selección, revisión, organización y preparación de materiales antes de publicación.",
      "Adaptación de contenidos para una plataforma web de alta frecuencia editorial.",
      "Seguimiento de contenidos en un entorno orientado a tráfico y audiencia digital.",
    ],
    results:
      "La operación editorial permitió coordinar más de 145,000 artículos con el equipo y contribuir a un promedio superior a 1 millón de usuarios únicos mensuales en la web de ATV.",
    skills: "Web Content · Editorial Management · Content Strategy · SEO · WordPress · Analítica",
  },
  "deportes-en-la-red": {
    title: "Deportes en la Red",
    eyebrow: "Caso de estudio · Programa digital",
    intro:
      "Desarrollo de un formato deportivo digital pensado para trasladar la experiencia de contenidos televisivos hacia plataformas digitales y construir una comunidad propia.",
    organization: "Grupo ATV",
    image: "/project-deportes.svg",
    reference: "https://www.atv.pe/",
    metrics: [
      ["9K", "pico de espectadores"],
      ["15K", "seguidores en 4 meses"],
    ],
    challenge:
      "El reto consistía en desarrollar una propuesta deportiva nativa para entornos digitales, con formatos capaces de generar audiencia y comunidad más allá de la emisión televisiva tradicional.",
    approach: [
      "Diseño y producción de programas digitales para redes sociales y web.",
      "Adaptación de contenidos deportivos a formatos de consumo digital.",
      "Distribución y promoción de contenidos para construir audiencia propia.",
      "Gestión de la comunidad alrededor del programa y sus contenidos.",
    ],
    results:
      "Deportes en la Red alcanzó picos de 9,000 espectadores en 2018 y el fanpage llegó a 15,000 seguidores en cuatro meses.",
    skills: "Digital Production · Sports Content · Social Media · Community Management · Video · Streaming",
  },
};

export function getStaticPaths() {
  return Object.keys(caseStudies).map((slug) => ({
    params: { slug },
    props: { caseStudy: caseStudies[slug as keyof typeof caseStudies] },
  }));
}

const { caseStudy } = Astro.props;
---

<Layout>
  <article class="py-20 md:py-28">
    <a href="/#projects" class="mb-12 inline-block text-sm text-neutral hover:text-white">← Volver a proyectos</a>

    <header class="max-w-4xl">
      <p class="mb-5 text-xs font-medium uppercase tracking-[0.2em] text-primary">{caseStudy.eyebrow}</p>
      <h1 class="font-serif text-5xl font-bold tracking-tightest text-white md:text-7xl">{caseStudy.title}</h1>
      <p class="mt-7 max-w-3xl text-lg leading-8 text-neutral md:text-xl">{caseStudy.intro}</p>
      <p class="mt-5 text-sm font-medium text-white/70">{caseStudy.organization}</p>
    </header>

    <div class="mt-14 overflow-hidden rounded-2xl border border-white/10 bg-[#151b24]">
      <img src={caseStudy.image} alt={caseStudy.title} class="w-full" width="1200" height="700" />
    </div>

    <div class="my-16 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 md:grid-cols-4">
      {caseStudy.metrics.map(([value, label]) => (
        <div class="bg-black p-6 md:p-8">
          <p class="font-serif text-4xl font-bold text-primary md:text-5xl">{value}</p>
          <p class="mt-2 text-sm leading-6 text-neutral">{label}</p>
        </div>
      ))}
    </div>

    <div class="grid gap-16 md:grid-cols-[1fr_280px] md:gap-20">
      <div class="space-y-16">
        <section>
          <p class="mb-4 text-xs font-medium uppercase tracking-[0.18em] text-neutral">01 · El reto</p>
          <h2 class="mb-5 font-serif text-3xl font-semibold text-white md:text-4xl">Objetivo y contexto</h2>
          <p class="text-base leading-8 text-neutral md:text-lg">{caseStudy.challenge}</p>
        </section>

        <section>
          <p class="mb-4 text-xs font-medium uppercase tracking-[0.18em] text-neutral">02 · El enfoque</p>
          <h2 class="mb-6 font-serif text-3xl font-semibold text-white md:text-4xl">Estrategia y ejecución</h2>
          <ul class="space-y-4">
            {caseStudy.approach.map((item) => (
              <li class="relative pl-7 text-base leading-8 text-neutral before:absolute before:left-0 before:top-1 before:text-primary before:content-['→']">{item}</li>
            ))}
          </ul>
        </section>

        <section>
          <p class="mb-4 text-xs font-medium uppercase tracking-[0.18em] text-neutral">03 · Resultados</p>
          <h2 class="mb-5 font-serif text-3xl font-semibold text-white md:text-4xl">Impacto</h2>
          <p class="text-base leading-8 text-neutral md:text-lg">{caseStudy.results}</p>
        </section>
      </div>

      <aside class="h-fit border-t border-white/10 pt-6 md:border-l md:border-t-0 md:pl-8 md:pt-0">
        <p class="mb-4 text-xs font-medium uppercase tracking-[0.18em] text-neutral">Especialidades</p>
        <p class="text-sm leading-7 text-white">{caseStudy.skills}</p>
        <a href={caseStudy.reference} target="_blank" rel="noreferrer" class="mt-8 inline-block text-sm font-medium text-primary hover:underline">Ver referencia ↗</a>
      </aside>
    </div>

    <div class="mt-20 border-t border-white/10 pt-8">
      <a href="/#projects" class="text-sm font-medium text-white hover:text-primary">← Explorar más proyectos</a>
    </div>
  </article>
</Layout>
