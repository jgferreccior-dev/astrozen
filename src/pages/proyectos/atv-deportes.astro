---
import Layout from "@layouts/Layout.astro";
import Section from "@components/Section.astro";
---

<Layout>
  <Section text="Caso de estudio" href="projects">
    <div class="max-w-4xl">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-primary">Grupo ATV · Sports Media</p>
      <h1 class="font-serif text-4xl font-semibold tracking-tight text-white md:text-6xl">Estrategia digital para grandes eventos deportivos</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-neutral">Landing pages, contenido web y distribución digital para eventos como Tokio 2020, Qatar 2022 y Champions League.</p>
      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-white/10 bg-[#0b1118] p-6"><strong class="font-serif text-4xl text-white">+30%</strong><p class="mt-2 text-sm text-neutral">tráfico web</p></div>
        <div class="rounded-2xl border border-white/10 bg-[#0b1118] p-6"><strong class="font-serif text-4xl text-white">−15%</strong><p class="mt-2 text-sm text-neutral">porcentaje de rebote</p></div>
      </div>
      <div class="mt-12 space-y-6 text-base leading-8 text-neutral">
        <h2 class="font-serif text-2xl font-semibold text-white">Enfoque</h2>
        <p>Coordinación de landing pages, contenidos y programas digitales asociados a grandes eventos deportivos, con énfasis en contenido exclusivo y distribución digital.</p>
        <p>La estrategia permitió incrementar el tráfico web en 30% y reducir el porcentaje de rebote en 15%.</p>
      </div>
      <a href="/#projects" class="mt-10 inline-block text-sm font-semibold text-primary hover:text-white">← Volver a proyectos</a>
    </div>
  </Section>
</Layout>
